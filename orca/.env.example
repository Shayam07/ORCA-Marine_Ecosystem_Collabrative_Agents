# ORCA Environment Configuration Template
# Copy this file to .env and fill in your private values.
# NEVER commit .env to GitHub.

# Database
DATABASE_URL=postgresql+asyncpg://orca:orca@localhost:5432/orca

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Required for reasoning & Q&A)
# Get a free Gemini key: https://aistudio.google.com/apikey
# Or a free Groq key: https://console.groq.com/keys
LLM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-2.0-flash

# ISRO / MOSDAC
MOSDAC_BASE_URL=
MOSDAC_API_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Copernicus Marine
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# NASA
NASA_API_KEY=
NASA_USERNAME=
NASA_PASSWORD=

# NOAA
NOAA_API_KEY=

# Fishing Activity (Global Fishing Watch)
FISHING_API_KEY=

# Map
MAPTILER_API_KEY=

# Supabase Auth & JWT Validation (Optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
