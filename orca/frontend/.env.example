# ORCA Frontend Environment Configuration Template
# Copy this file to .env and set VITE_API_URL to your reachable backend address.
# NEVER commit .env to GitHub.

# Web Browser Development:
# Leave VITE_API_URL empty so Vite's dev server proxies /api calls to http://localhost:8000
# VITE_API_URL=

# Physical Android Phone (Capacitor):
# Replace with your host computer's Wi-Fi IP address (e.g., http://192.168.1.50:8000)
VITE_API_URL=http://localhost:8000

# Android Emulator:
# VITE_API_URL=http://10.0.2.2:8000

# Production Deployed Backend:
# VITE_API_URL=https://your-orca-api-domain.com

# ==============================================================================
# Supabase Authentication & Realtime Database
# ==============================================================================
# Obtain these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
