# ==============================================================================
# ORCA .gitignore — Secrets, Dependencies, and Build Artifacts
# ==============================================================================

# --- Secrets & Environment Configurations (CRITICAL) ---
.env
.env.*
!.env.example
*.env
*.env.local
*.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# --- Logs & Runtime Output ---
*.log
*.log.err
*.err
*.out
..backend.log

# --- Node & Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Android / Capacitor Mobile Builds ---
android/.gradle/
android/build/
android/app/build/
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/capacitor-cordova-android-plugins/build/
*.apk
*.aab

# --- Local Data & Cache ---
data/cache/*
!data/cache/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.sqlite3
*.db

# --- OS & Editor Specific ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
